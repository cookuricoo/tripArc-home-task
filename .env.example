# Copy to .env. Never commit credentials.
ANDROID_UDID=emulator-5554
# Exactly two booted devices for test:parallel:
ANDROID_UDIDS=emulator-5554,emulator-5556
ANDROID_APP_PATH=apps/mda-2.3.0-27.apk
# Set ANDROID_HOME and JAVA_HOME in your shell according to docs/setup.md.

# Sauce Labs Real Device Cloud. Username and access key: Account > User Settings.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
# Account data center: us-west-1, us-east-4, or eu-central-1.
SAUCE_REGION=us-west-1
# Fill from npm run cloud:upload -- android / ios (storage:<file id>):
SAUCE_ANDROID_APP=
SAUCE_IOS_APP=
# Display name or regex, and OS version, from the account's real-device list.
# A major OS version matches that release and its incremental versions.
SAUCE_ANDROID_DEVICE=Google Pixel 8
SAUCE_ANDROID_OS=14
SAUCE_IOS_DEVICE=iPhone 15
SAUCE_IOS_OS=17
BUILD_NAME=triparc-native-2.3.0
